APP_NAME="Electrical CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Identifies this deployment. All business-identity facts (company name,
# ABN, REC number, address, bank details, logos, etc.) live in the
# database instead — fill them in via Settings > Company Profile after
# first login, not here.
CLIENT_NAME=""

# First super-admin account — created by `php artisan company:setup`
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Set these to match the company_name/email you enter in Settings > Company Profile
MAIL_FROM_ADDRESS="info@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS Notifications — driver: log (default, no real sending), twilio, clicksend, messagemedia
SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
# Leave unset to use the company_settings name automatically (see ClickSendSmsDriver)
CLICKSEND_FROM=
MESSAGEMEDIA_API_KEY=
MESSAGEMEDIA_API_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ASSET_URL=/

# Path to the Python interpreter used for the AI quoting/classification sidecar
PYTHON_PATH=python
